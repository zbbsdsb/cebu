@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies
find_dependency(nlohmann_json 3.2.0)

# Find ZLIB (optional)
find_package(ZLIB QUIET)
if (ZLIB_FOUND)
    add_definitions(-DZLIB_FOUND)
endif()

# Link to exported targets
include("${CMAKE_CURRENT_LIST_DIR}/cebuTargets.cmake")

check_required_components(cebu)
